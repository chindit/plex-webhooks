{
  "name": "plex-webhooks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Plex webhook receiver and weekly movie digest",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "cli": "node dist/cli.js",
    "cli:dev": "tsx src/cli.ts",
    "mail:new-movies": "npm run cli -- app:mail:new-movies",
    "webhook:purge": "npm run cli -- app:webhook:purge",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.2",
    "fast-xml-parser": "^5.3.0",
    "file-type": "^22.0.2",
    "handlebars": "^4.7.8",
    "juice": "^12.1.3",
    "multer": "2.3.0",
    "nodemailer": "^10.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "multer": "2.3.0",
    "mysql2": "3.24.4"
  }
}
