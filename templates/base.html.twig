{% apply inline_css %}
    <style>
        dt {
            font-weight: bold;
        }
        dd {
            margin: 0 0 10px 20px;
        }
        .double-line {
            display: grid;
            grid-template-columns: 1fr 75%;
        }
        .is-marged-top {
            margin-top: 25px;
        }
        .is-title {
            font-weight: bold;
            font-size: x-large;
        }
        .justify {
            text-align: justify;
        }
        .center {
            margin: 0 auto 10px auto;
            text-align: center;
        }
        .align-end {
            justify-self: center;
        }
    </style>
<body>
    <div class="container">
        <div class="is-title center">Films de la semaine</div>
        <div class="mb-3">Voici les films (et séries) qui ont fait leur arrivée sur le NAS cette semaine:</div>
        {% for item in movies %}
            <div class="is-title is-marged-top">{{ item.title }}</div>
            <div class="double-line">
                <div class="align-end">
                    {% if item.thumb %}
                        <img src="cid:{{ item.movie.ratingKey }}" class="card-img-top" style="width:150px;" alt="{{ item.title }}">
                    {% endif %}
                </div>
                <div class="justify">
                    {% if item.hasDetails %}
                        {{ item.movie.summary }}
                    {% endif %}
                </div>
            </div>
            {% if item.hasDetails %}
                <dl>
                    <dt>Année de sortie</dt>
                    <dd>{{ item.movie.year|default('—') }}</dd>
                    <dt>Durée</dt>
                    <dd>
                        {% if item.movie.duration > 0 %}
                            {{ item.movie.duration // 3600 }}h{{ '%02d'|format((item.movie.duration % 3600) // 60) }}m
                        {% else %}
                            —
                        {% endif %}
                    </dd>
                    <dt>Genres</dt>
                    <dd>{{ item.movie.genres|join(', ')|default('—') }}</dd>
                    <dt>Acteurs</dt>
                    <dd>{{ item.movie.actors|slice(0, 5)|join(', ')|default('—') }}</dd>
                </dl>
            {% endif %}
            {% if item.episodeCount > 0 %}
                <p><strong>=&gt; {{ item.episodeCount }} {{ item.episodeCount == 1 ? 'épisode ajouté' : 'épisodes ajoutés' }}</strong></p>
            {% endif %}
        {% endfor %}
    </div>
{% endapply %}
